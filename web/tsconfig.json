{
    "compilerOptions": {
        "allowImportingTsExtensions": true,
        "strict": true,
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "isolatedModules": true,
        "noEmit": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "lib": ["ES2022", "DOM", "DOM.Iterable"]
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist"]
}
